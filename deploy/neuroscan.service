[Unit]
Description=NeuroScan NG (gunicorn)
After=network.target

[Service]
User=neuroscan
WorkingDirectory=/opt/neuroscan-ng
Environment=NEUROSCAN_SECRET=CHANGE_ME_LONG_RANDOM
ExecStart=/opt/neuroscan-ng/venv/bin/gunicorn -b 127.0.0.1:8000 -w 2 --timeout 120 app:app
Restart=always

[Install]
WantedBy=multi-user.target
